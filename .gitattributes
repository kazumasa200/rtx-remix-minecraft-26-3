# Java sources are stored and checked out LF, so an edit never renormalises
# a file's other lines into the diff.
*.java text eol=lf

# PowerShell must stay CRLF: the CI runners are Windows PowerShell 5.1.
*.ps1 text eol=crlf
# cmd.exe resolves call/goto labels by scanning lines, which misfires on LF-only
# scripts, so batch entry points such as Packman's packman.cmd check out CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Written by the runtime patch build with LF, whatever the checkout.
runtime-patch/patches.lock text eol=lf
runtime-patch/shaders/compiled/*.txt text eol=lf
runtime-patch/shaders/compiled/*.sha256 text eol=lf
tools/src/rtx_tools/runtime_patch/operands.json text eol=lf
# Compiled SPIR-V.
*.spv binary

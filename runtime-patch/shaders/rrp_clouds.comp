// The Unbound clouds as a library for the runtime's own shaders: cloud_field.glsl, the field the GL dome and
// lens march, compiled for Vulkan against the frame at set 4 (rrp_frame.glsl). main only calls the exports so
// glslang keeps them; the patch build merges an export, and what it reaches, into each module that calls it
// (runtime_patch/merge.py), and never main.
#version 460
#extension GL_GOOGLE_include_directive : require

#include "rrp_frame.glsl"

#define PI 3.14159265358979323846
#define CIRRUS_MIN_ELEVATION_DEGREES CirrusMinElevation
#define CLOUD_FIELD_EXTERNAL_SHAPES
// The lens's step counts: the runtime's upscaler folds the jittered march of every pixel over frames, as
// the lens's history did.
#define CLOUD_MIN_STEPS 20
#define CLOUD_MAX_STEPS 40
#define CLOUD_ALTO_STEPS 6
// Compute and ray-tracing stages have no implicit derivatives, and the GL samplers have no mips, so level 0
// is what GL sampled too.
#define texture(s, c) textureLod(s, c, 0.0)

// Where a march starts, in the clouds' frame; each export sets them from its caller's camera.
vec2 CameraXZ;
float CameraHeight;

#include "cloud_field.glsl"

// Interleaved gradient noise, turned by the golden ratio each frame: an even spread over a pixel's
// neighbours that the upscaler averages.
float rrpJitter(uvec2 pixel) {
    float n = fract(52.9829189 * fract(0.06711056 * float(pixel.x) + 0.00583715 * float(pixel.y)));
    return fract(n + 0.61803398875 * float(FrameIndex & 1023u));
}

// The clouds seen from the camera at scene position camera along direction, premultiplied radiance and
// opacity in the sky matte's units, the cirrus behind them, as the GL panorama holds them: what the
// composite lays over the sky a primary ray that missed shows. Nothing while the mod draws them itself.
vec4 rrp_cloudsPrimary(vec3 direction, vec3 camera, uvec2 pixel) {
    if (Enabled == 0u) {
        return vec4(0.0);
    }
    CameraXZ = camera.xz + SceneToCloud;
    CameraHeight = camera.y;
    float entry;
    vec4 clouds = marchCloudsTo(normalize(direction), rrpJitter(pixel), MAX_DISTANCE, entry);
    return clouds + (1.0 - clouds.a) * cirrusLayer(normalize(direction));
}

// The clouds between the camera and a surface limit blocks along direction, premultiplied, in the sky matte's
// units: what the composite lays over land seen through or beyond them, as when flying in or above the clouds
// or looking at distant terrain behind them. Nothing for a limit of 0 (a miss, or sky seen through glass).
vec4 rrp_cloudsLand(vec3 direction, vec3 camera, uvec2 pixel, float limit) {
    if (Enabled == 0u || limit <= 0.0) {
        return vec4(0.0);
    }
    CameraXZ = camera.xz + SceneToCloud;
    CameraHeight = camera.y;
    float entry;
    return marchCloudsTo(normalize(direction), rrpJitter(pixel), limit, entry);
}

// The clouds the frame's camera sees along direction, from the layer's sky cache: what a reflection, a ray
// through glass or water, or an indirect ray that missed lays over the sky probe, as the dome gave them.
vec4 rrp_cloudsSky(vec3 direction) {
    if (Enabled == 0u) {
        return vec4(0.0);
    }
    return textureLod(RrpSkyCache, rrpOctEncode(normalize(direction)), 0.0);
}

// The share of a shadow ray's light the clouds let through: 1 unless the ray is the clouds' light's, long as a
// distant light's and within the light's cone, so a lamp's light never dims under a cloud. Each layer counts
// only for a point below its middle, as the clouds' own shadow reads them.
float rrp_cloudShadow(vec3 origin, vec3 direction, float tMax) {
    if (Enabled == 0u || ShadowStrength <= 0.0 || tMax < DistantRayMin
            || dot(normalize(direction), LightDirection) < LightConeCos) {
        return 1.0;
    }
    if (ShadowTelltale > 0.5) {
        return 0.0;  // what the clouds' light lights goes dark; a lamp's light, never gated here, stays
    }
    vec3 cloud = vec3(origin.x + SceneToCloud.x, origin.y, origin.z + SceneToCloud.y);
    vec2 uv = rrpShadowUv(cloud.xz, cloud.y);
    if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) {
        return 1.0;
    }
    vec3 depth = textureLod(RrpCloudShadow, uv, 0.0).xyz;
    vec3 below = vec3(
        cloud.y < layerBase(LAYER_SMALL) + layerThickness(LAYER_SMALL) * 0.4 ? 1.0 : 0.0,
        cloud.y < layerBase(LAYER_LARGE) + layerThickness(LAYER_LARGE) * 0.4 ? 1.0 : 0.0,
        cloud.y < layerBase(LAYER_ALTO) + layerThickness(LAYER_ALTO) * 0.4 ? 1.0 : 0.0);
    return mix(1.0, exp(-dot(depth, below)), ShadowStrength);
}

layout(local_size_x = 1) in;
void main() {
    vec4 keep = rrp_cloudsPrimary(vec3(0.0, 1.0, 0.0), vec3(0.0), uvec2(0u))
        + rrp_cloudsLand(vec3(0.0, 1.0, 0.0), vec3(0.0), uvec2(0u), 1.0)
        + rrp_cloudsSky(vec3(0.0, 1.0, 0.0)) + vec4(rrp_cloudShadow(vec3(0.0), vec3(0.0, 1.0, 0.0), 1.0));
}
